{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python .agent-harness/hooks/stop_gate.py" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          { "type": "command", "command": "python .agent-harness/hooks/audit_log.py" }
        ]
      }
    ]
  }
}
