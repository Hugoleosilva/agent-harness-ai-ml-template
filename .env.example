# =========================================================================
# AI MODEL FACTORY - SECRETS TEMPLATE
# Copy this file to '.env' and fill in your private keys.
# NEVER commit the real '.env' file to Git. Keep only placeholders here.
# =========================================================================

# LLM Providers (fill only what you use)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Model & Dataset Hubs
HF_TOKEN=your_huggingface_token_here
KAGGLE_USERNAME=your_kaggle_username_here
KAGGLE_KEY=your_kaggle_key_here

# Experiment Tracking (optional)
WANDB_API_KEY=your_wandb_api_key_here
MLFLOW_TRACKING_URI=http://localhost:5000

# Cloud Storage for datasets / weights (optional)
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=your_bucket_name_here

# MCP Servers Credentials (only if you enable them in mcp-config.json)
MCP_GITHUB_TOKEN=your_github_personal_access_token_here

# Runtime
PYTHONHASHSEED=42
CUDA_VISIBLE_DEVICES=0
